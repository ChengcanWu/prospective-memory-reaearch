# Copy to .env and fill in real keys. .env is gitignored.
# python code/run_pm_memory.py --list-providers

# Optional default when you omit --provider
# DEFAULT_PROVIDER=qwen

# --- Qwen / 浦语 token 网关 ---
QWEN_API_KEY=
QWEN_BASE_URL=https://token.pjlab.org.cn/v1
QWEN_MODEL=qwen3.5-397b
# QWEN_RESPONSE_FORMAT=json_schema

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_RESPONSE_FORMAT=json_object

# --- 任意新模型：改前缀即可，例如 ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_RESPONSE_FORMAT=json_object

# --- Mem0 embedding（--use-qwen-embed 或 DeepSeek+Mem0 时需要）---
MEM0_EMBED_API_KEY=
MEM0_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEM0_EMBED_MODEL=text-embedding-v3
MEM0_EMBED_DIMS=1536
